PORT=3000
BASE_URL=https://monitor.example.it
# public domain served by Caddy (used by compose.yaml)
CSP_DOMAIN=monitor.example.it
DATA_DIR=/data
# generate with: npm run hash-password; keep the single quotes (the hash contains $)
ADMIN_PASSWORD_HASH=''
# at least 32 characters
SESSION_SECRET=
TRUST_PROXY=1
SECURE_COOKIES=1
SMTP_HOST=smtp.example.it
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=csp-monitor@example.it
SMTP_SECURE=0
ALERT_EMAIL=admin@example.it
